@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="auth-page">

    @* ============ Brand Panel (Left) ============ *@
    <aside class="auth-brand">
        <div class="auth-brand-inner">
            <div class="auth-brand-icon">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <h1 class="auth-brand-title">Create your CipherVault</h1>
            <p class="auth-brand-tagline">
                A personal encrypted vault for your passwords, API keys, and secure notes.
            </p>
            <ul class="auth-brand-features">
                <li>
                    <i class="bi bi-lock-fill"></i>
                    <span>Strong passwords required — enforced by policy</span>
                </li>
                <li>
                    <i class="bi bi-shield-check"></i>
                    <span>Account lockout after 5 failed attempts</span>
                </li>
                <li>
                    <i class="bi bi-key-fill"></i>
                    <span>Everything encrypted before it hits the database</span>
                </li>
                <li>
                    <i class="bi bi-code-slash"></i>
                    <span>Free and open for personal use</span>
                </li>
            </ul>
        </div>
    </aside>

    @* ============ Form Panel (Right) ============ *@
    <div class="auth-form-wrap">
        <div class="auth-form">

            <div class="auth-form-header">
                <h2>Create account</h2>
                <p>Choose a strong password. It protects your vault access.</p>
            </div>

            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div class="auth-form-body">

                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                    {
                        <div class="alert alert-danger" role="alert">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <div asp-validation-summary="ModelOnly"></div>
                        </div>
                    }

                    <div class="auth-field">
                        <label asp-for="Input.Email">Email</label>
                        <input asp-for="Input.Email" class="form-control" type="email" autocomplete="username"
                               placeholder="you@example.com" autofocus />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="Input.Password">Password</label>
                        <div class="auth-password-wrap">
                            <input asp-for="Input.Password" id="register-password" class="form-control" type="password"
                                   autocomplete="new-password" placeholder="At least 8 characters" />
                            <button type="button" id="toggle-register-password" class="input-action" tabindex="-1"
                                    title="Show / hide password">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>

                        <div class="auth-strength" id="register-strength" data-strength="0">
                            <div class="seg"></div>
                            <div class="seg"></div>
                            <div class="seg"></div>
                            <div class="seg"></div>
                        </div>

                        <span asp-validation-for="Input.Password" class="text-danger"></span>

                        <div class="auth-hint">
                            Must contain uppercase, lowercase, digit, and a special character.
                        </div>
                    </div>

                    <div class="auth-field">
                        <label asp-for="Input.ConfirmPassword">Confirm password</label>
                        <div class="auth-password-wrap">
                            <input asp-for="Input.ConfirmPassword" id="confirm-password" class="form-control"
                                   type="password" autocomplete="new-password" placeholder="Re-enter your password" />
                            <button type="button" id="toggle-confirm-password" class="input-action" tabindex="-1"
                                    title="Show / hide password">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>

                    <button id="register-submit" type="submit" class="btn btn-primary auth-submit">
                        <i class="bi bi-person-plus"></i> Create account
                    </button>

                </div>
            </form>

            <div class="auth-footer">
                Already have an account?
                <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Sign in</a>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            'use strict';

            function wireToggle(inputId, btnId) {
                const input = document.getElementById(inputId);
                const btn = document.getElementById(btnId);
                if (!input || !btn) return;
                btn.addEventListener('click', () => {
                    const isPwd = input.type === 'password';
                    input.type = isPwd ? 'text' : 'password';
                    btn.innerHTML = isPwd
                        ? '<i class="bi bi-eye-slash"></i>'
                        : '<i class="bi bi-eye"></i>';
                });
            }

            wireToggle('register-password', 'toggle-register-password');
            wireToggle('confirm-password', 'toggle-confirm-password');

            // Password strength meter
            const pwd = document.getElementById('register-password');
            const meter = document.getElementById('register-strength');
            if (pwd && meter) {
                pwd.addEventListener('input', () => {
                    const v = pwd.value;
                    let score = 0;
                    if (v.length >= 8) score++;
                    if (v.length >= 12) score++;
                    if (/[a-z]/.test(v) && /[A-Z]/.test(v)) score++;
                    if (/\d/.test(v)) score++;
                    if (/[^A-Za-z0-9]/.test(v)) score++;
                    meter.setAttribute('data-strength', Math.min(score, 4));
                });
            }
        })();
    </script>
}