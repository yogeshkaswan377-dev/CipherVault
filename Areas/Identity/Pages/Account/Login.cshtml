@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
}

<div class="auth-page">

    @* ============ Brand Panel (Left) ============ *@
    <aside class="auth-brand">
        <div class="auth-brand-inner">
            <div class="auth-brand-icon">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <h1 class="auth-brand-title">Welcome back to CipherVault</h1>
            <p class="auth-brand-tagline">
                Your secrets are encrypted at rest. Log in to reveal them when you need them.
            </p>
            <ul class="auth-brand-features">
                <li>
                    <i class="bi bi-shield-lock-fill"></i>
                    <span>Secrets encrypted with the Data Protection API</span>
                </li>
                <li>
                    <i class="bi bi-eye-slash-fill"></i>
                    <span>Values masked by default, reveal on demand</span>
                </li>
                <li>
                    <i class="bi bi-clipboard-check"></i>
                    <span>Clipboard clears itself after 10 seconds</span>
                </li>
                <li>
                    <i class="bi bi-shuffle"></i>
                    <span>Cryptographically secure password generator</span>
                </li>
            </ul>
        </div>
    </aside>

    @* ============ Form Panel (Right) ============ *@
    <div class="auth-form-wrap">
        <div class="auth-form">

            <div class="auth-form-header">
                <h2>Sign in</h2>
                <p>Enter your credentials to access your vault.</p>
            </div>

            <form id="account" method="post" asp-route-returnUrl="@Model.ReturnUrl">
                <div class="auth-form-body">

                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                    {
                        <div class="alert alert-danger" role="alert">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <div asp-validation-summary="ModelOnly"></div>
                        </div>
                    }

                    <div class="auth-field">
                        <label asp-for="Input.Email">Email</label>
                        <input asp-for="Input.Email" class="form-control" type="email" autocomplete="username"
                               placeholder="you@example.com" autofocus />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="Input.Password">Password</label>
                        <div class="auth-password-wrap">
                            <input asp-for="Input.Password" id="password-input" class="form-control" type="password"
                                   autocomplete="current-password" placeholder="Enter your password" />
                            <button type="button" id="toggle-password" class="input-action" tabindex="-1"
                                    title="Show / hide password">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <div class="auth-row">
                        <label class="form-check">
                            <input asp-for="Input.RememberMe" class="form-check-input" />
                            <span class="form-check-label">Remember me</span>
                        </label>
                    </div>

                    <button id="login-submit" type="submit" class="btn btn-primary auth-submit">
                        <i class="bi bi-box-arrow-in-right"></i> Sign in
                    </button>

                </div>
            </form>

            <div class="auth-footer">
                Don't have an account?
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create one now</a>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            'use strict';
            const input = document.getElementById('password-input');
            const toggle = document.getElementById('toggle-password');
            if (!input || !toggle) return;

            toggle.addEventListener('click', () => {
                const isPwd = input.type === 'password';
                input.type = isPwd ? 'text' : 'password';
                toggle.innerHTML = isPwd
                    ? '<i class="bi bi-eye-slash"></i>'
                    : '<i class="bi bi-eye"></i>';
            });
        })();
    </script>
}