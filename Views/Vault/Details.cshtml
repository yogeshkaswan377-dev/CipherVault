@model CipherVault.DTOs.VaultItemDisplayDTO
@using CipherVault.Helpers
@{
    ViewData["Title"] = Model.Title;

    var maskedNotes = "••••••••••••••••";
}

@* Hidden anti-forgery token for reveal fetch calls *@
<form id="af-token" class="d-none">@Html.AntiForgeryToken()</form>

<a asp-action="Index" class="details-back">
    <i class="bi bi-arrow-left"></i>
    <span>Back to Vault</span>
</a>

@* ---------- Title row ---------- *@
<div class="details-title-row">
    <div class="details-title">
        <span class="details-title-icon" data-category="@Model.Category">
            <i class="bi @VaultCategoryIcons.For(Model.Category)"></i>
        </span>
        <div class="details-title-text">
            <h1>@Model.Title</h1>
            <span class="subtitle">
                <span class="badge badge-category" data-category="@Model.Category">
                    @Model.Category
                </span>
                <span>·</span>
                <span>
                    Updated
                    <time class="js-local-time" datetime="@Model.UpdatedAt.ToString("o")">
                        @Model.UpdatedAt.ToString("MMM dd, yyyy")
                    </time>
                </span>
            </span>
        </div>
    </div>

    <div class="details-actions">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-light">
            <i class="bi bi-pencil"></i> Edit
        </a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
            <i class="bi bi-trash"></i> Delete
        </a>
    </div>
</div>

@* ---------- Two-column layout ---------- *@
<div class="details-layout">

    @* ============ MAIN COLUMN ============ *@
    <div>

        @* ---------- Secret section ---------- *@
        <section class="details-section">
            <header class="details-section-header">
                <span class="details-section-title">
                    <i class="bi bi-shield-lock-fill"></i>
                    <span>Secret</span>
                </span>
                <span class="badge badge-category" data-category="Password">Encrypted</span>
            </header>

            <div class="details-section-body">
                <div class="secret-field">
                    <div id="secret-value" class="secret-display is-masked" data-masked="@Model.MaskedSecret"
                         data-revealed="false">
                        <i class="bi bi-shield-lock-fill"></i>
                        <span class="value">@Model.MaskedSecret</span>
                    </div>
                </div>

                <div class="field-actions">
                    <button type="button" id="btnRevealSecret" class="btn btn-outline-warning js-reveal"
                            data-target="secret-value"
                            data-url="@Url.Action("RevealSecret", "Vault", new { id = Model.Id })">
                        <i class="bi bi-eye"></i> Reveal
                    </button>

                    <button type="button" id="btnCopySecret" class="btn btn-outline-light"
                            data-copy-target="#secret-value" disabled>
                        <i class="bi bi-clipboard"></i> Copy
                    </button>
                </div>
            </div>
        </section>

        @* ---------- Notes section ---------- *@
        @if (Model.HasNotes)
        {
            <section class="details-section">
                <header class="details-section-header">
                    <span class="details-section-title">
                        <i class="bi bi-journal-text"></i>
                        <span>Notes</span>
                    </span>
                    <span class="badge badge-category" data-category="Note">Encrypted</span>
                </header>

                <div class="details-section-body">
                    <div id="notes-value" class="notes-display is-masked" data-masked="@maskedNotes" data-revealed="false">
                        @maskedNotes
                    </div>

                    <div class="field-actions mt-3">
                        <button type="button" id="btnRevealNotes" class="btn btn-outline-warning js-reveal"
                                data-target="notes-value" data-url="@Url.Action("RevealNotes", "Vault", new { id = Model.Id })">
                            <i class="bi bi-eye"></i> Reveal
                        </button>

                        <button type="button" id="btnCopyNotes" class="btn btn-outline-light"
                                data-copy-target="#notes-value" disabled>
                            <i class="bi bi-clipboard"></i> Copy
                        </button>
                    </div>
                </div>
            </section>
        }

    </div>

    @* ============ SIDEBAR ============ *@
    <aside class="details-meta">
        <div class="details-meta-header">
            <i class="bi bi-info-circle"></i>
            <span>Item Details</span>
        </div>

        <ul class="details-meta-list">

            <li>
                <span class="meta-label">Category</span>
                <span class="meta-value">@Model.Category</span>
            </li>

            <li>
                <span class="meta-label">Username</span>
                @if (!string.IsNullOrWhiteSpace(Model.Username))
                {
                    <span class="meta-value">@Model.Username</span>
                }
                else
                {
                    <span class="meta-value is-muted">Not set</span>
                }
            </li>

            <li>
                <span class="meta-label">URL</span>
                @if (!string.IsNullOrWhiteSpace(Model.Url))
                {
                    <span class="meta-value">
                        <a href="@Model.Url" target="_blank" rel="noopener noreferrer">
                            @Model.Url
                            <i class="bi bi-box-arrow-up-right" style="font-size: 0.72em; margin-left: 2px;"></i>
                        </a>
                    </span>
                }
                else
                {
                    <span class="meta-value is-muted">Not set</span>
                }
            </li>

            <li>
                <span class="meta-label">Created</span>
                <span class="meta-value">
                    <time class="js-local-time" datetime="@Model.CreatedAt.ToString("o")">
                        @Model.CreatedAt.ToString("MMM dd, yyyy 'at' HH:mm")
                    </time>
                </span>
            </li>

            <li>
                <span class="meta-label">Last Updated</span>
                <span class="meta-value">
                    <time class="js-local-time" datetime="@Model.UpdatedAt.ToString("o")">
                        @Model.UpdatedAt.ToString("MMM dd, yyyy 'at' HH:mm")
                    </time>
                </span>
            </li>

        </ul>
    </aside>

</div>

@section Scripts {
    <script src="~/js/clipboard.js" asp-append-version="true"></script>
    <script>
        (function () {
            'use strict';
            const AUTO_HIDE_MS = 30000;

            function getToken() {
                const el = document.querySelector('#af-token input[name="__RequestVerificationToken"]');
                return el ? el.value : '';
            }

            function setRevealed(el, revealed, plaintext) {
                el.setAttribute('data-revealed', revealed ? 'true' : 'false');
                if (revealed) {
                    el.classList.remove('is-masked');
                    el.textContent = plaintext;
                } else {
                    el.classList.add('is-masked');
                    el.textContent = el.getAttribute('data-masked');
                }
            }

            function updateButtonLabel(btn, revealed) {
                const icon = revealed ? 'bi-eye-slash' : 'bi-eye';
                const label = revealed ? 'Hide' : 'Reveal';
                btn.innerHTML = '<i class="bi ' + icon + '"></i> ' + label;
                btn.classList.toggle('btn-outline-warning', !revealed);
                btn.classList.toggle('btn-warning', revealed);
            }

            document.querySelectorAll('.js-reveal').forEach(btn => {
                btn.addEventListener('click', async () => {
                    const target = document.getElementById(btn.dataset.target);
                    if (!target) return;

                    // --- Toggle back to masked ---
                    if (target.getAttribute('data-revealed') === 'true') {
                        setRevealed(target, false, null);
                        updateButtonLabel(btn, false);
                        if (btn._timer) clearTimeout(btn._timer);
                        return;
                    }

                    // --- Fetch plaintext ---
                    btn.disabled = true;
                    try {
                        const body = new URLSearchParams();
                        body.append('__RequestVerificationToken', getToken());

                        const res = await fetch(btn.dataset.url, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body
                        });

                        if (!res.ok) {
                            alert('Unable to reveal value.');
                            return;
                        }

                        const data = await res.json();
                        const plaintext = data.value ?? data.secret ?? data.notes ?? '';
                        setRevealed(target, true, plaintext);
                        updateButtonLabel(btn, true);

                        // Auto-hide after 30s
                        btn._timer = setTimeout(() => {
                            setRevealed(target, false, null);
                            updateButtonLabel(btn, false);
                        }, AUTO_HIDE_MS);
                    } catch (err) {
                        console.error('[reveal] error', err);
                        alert('Network error while revealing value.');
                    } finally {
                        btn.disabled = false;
                    }
                });
            });
        })();
    </script>
}