@model CipherVault.DTOs.VaultItemDisplayDTO
@{
    ViewData["Title"] = Model.Title;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@Model.Title</h1>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Edit</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Delete</a>
        <a asp-action="Index" class="btn btn-link">Back</a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Category</dt><dd class="col-sm-9">@Model.Category</dd>
            <dt class="col-sm-3">Username</dt><dd class="col-sm-9">@(Model.Username ?? "—")</dd>
            <dt class="col-sm-3">URL</dt>
            <dd class="col-sm-9">
                @if (!string.IsNullOrWhiteSpace(Model.Url))
                {
                    <a href="@Model.Url" target="_blank" rel="noopener noreferrer">@Model.Url</a>
                }
                else { <text>—</text> }
            </dd>
            <dt class="col-sm-3">Created</dt><dd class="col-sm-9">@Model.CreatedAt.ToLocalTime()</dd>
            <dt class="col-sm-3">Updated</dt><dd class="col-sm-9">@Model.UpdatedAt.ToLocalTime()</dd>
        </dl>
    </div>
</div>

@* One anti-forgery token is enough for all fetch calls on this page. *@
<form id="af-token" class="d-none">@Html.AntiForgeryToken()</form>

<div class="mb-4">
    <label class="form-label fw-semibold">Secret</label>
    <div class="input-group">
        <input type="text" class="form-control font-monospace"
               id="secret-value" value="@Model.MaskedSecret" readonly />
        <button type="button" class="btn btn-outline-warning js-reveal"
                data-url="@Url.Action("RevealSecret", new { id = Model.Id })"
                data-target="secret-value"
                data-mask="@Model.MaskedSecret">Reveal</button>
    </div>
</div>

@if (Model.HasNotes)
{
    <div class="mb-4">
        <label class="form-label fw-semibold">Notes</label>
        <div class="input-group">
            <textarea class="form-control font-monospace" id="notes-value" rows="3" readonly>@Model.MaskedSecret</textarea>
            <button type="button" class="btn btn-outline-warning js-reveal"
                    data-url="@Url.Action("RevealNotes", new { id = Model.Id })"
                    data-target="notes-value"
                    data-mask="@Model.MaskedSecret">Reveal</button>
        </div>
    </div>
}

@section Scripts {
<script>
(function () {
    'use strict';
    const AUTO_HIDE_MS = 30000;

    function getToken() {
        const el = document.querySelector('#af-token input[name="__RequestVerificationToken"]');
        return el ? el.value : '';
    }

    document.querySelectorAll('.js-reveal').forEach(btn => {
        btn.addEventListener('click', async () => {
            const target = document.getElementById(btn.dataset.target);
            const masked = btn.dataset.mask;

            // Toggle back to masked state.
            if (btn.dataset.revealed === 'true') {
                target.value = masked;
                btn.dataset.revealed = 'false';
                btn.textContent = 'Reveal';
                btn.classList.remove('btn-warning');
                btn.classList.add('btn-outline-warning');
                if (btn._timer) clearTimeout(btn._timer);
                return;
            }

            btn.disabled = true;
            try {
                const body = new URLSearchParams();
                body.append('__RequestVerificationToken', getToken());

                const res = await fetch(btn.dataset.url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body
                });

                if (!res.ok) { alert('Unable to reveal value.'); return; }

                const data = await res.json();
                target.value = data.value;
                btn.dataset.revealed = 'true';
                btn.textContent = 'Hide';
                btn.classList.remove('btn-outline-warning');
                btn.classList.add('btn-warning');

                btn._timer = setTimeout(() => {
                    target.value = masked;
                    btn.dataset.revealed = 'false';
                    btn.textContent = 'Reveal';
                    btn.classList.remove('btn-warning');
                    btn.classList.add('btn-outline-warning');
                }, AUTO_HIDE_MS);
            } catch {
                alert('Network error while revealing value.');
            } finally {
                btn.disabled = false;
            }
        });
    });
})();
</script>
}