@model CipherVault.DTOs.VaultItemDisplayDTO
@{
    ViewData["Title"] = Model.Title;

    // Notes placeholder — DTO only exposes MaskedSecret, so use a fixed mask
    // to avoid leaking length information about the notes.
    const string MaskedNotes = "••••••••••••";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@Model.Title</h1>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Edit</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Delete</a>
        <a asp-action="Index" class="btn btn-link">Back</a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Category</dt>
            <dd class="col-sm-9">@Model.Category</dd>
            <dt class="col-sm-3">Username</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Username) ? "—" : Model.Username)</dd>
            <dt class="col-sm-3">URL</dt>
            <dd class="col-sm-9">
                @if (!string.IsNullOrWhiteSpace(Model.Url))
                {
                    <a href="@Model.Url" target="_blank" rel="noopener noreferrer">@Model.Url</a>
                }
                else
                {
                    <text>—</text>
                }
            </dd>
            <dt class="col-sm-3">Created</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>
            <dt class="col-sm-3">Updated</dt>
            <dd class="col-sm-9">@Model.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>
        </dl>
    </div>
</div>

@* Single anti-forgery token used by all reveal fetch calls on this page. *@
<form id="af-token" class="d-none">@Html.AntiForgeryToken()</form>

@* ---------- Secret ---------- *@
<div class="mb-4">
    <label class="form-label fw-semibold" for="secret-value">Secret</label>
    <div class="input-group">
        <input type="text" id="secret-value" class="form-control font-monospace" value="@Model.MaskedSecret"
               data-masked="@Model.MaskedSecret" data-revealed="false" readonly />

        <button type="button" id="btnRevealSecret" class="btn btn-outline-primary js-reveal" data-target="secret-value"
                data-url="@Url.Action("RevealSecret", "Vault", new { id = Model.Id })">
            <i class="bi bi-eye"></i> Reveal
        </button>

        <button type="button" id="btnCopySecret" class="btn btn-outline-secondary" data-copy-target="#secret-value"
                disabled>
            <i class="bi bi-clipboard"></i> Copy
        </button>
    </div>
</div>

@* ---------- Notes ---------- *@
@if (Model.HasNotes)
{
    <div class="mb-4">
        <label class="form-label fw-semibold" for="notes-value">Notes</label>
        <div class="input-group">
            <textarea id="notes-value" class="form-control font-monospace" rows="4" data-masked="@MaskedNotes"
                      data-revealed="false" readonly>@MaskedNotes</textarea>

            <button type="button" id="btnRevealNotes" class="btn btn-outline-primary js-reveal" data-target="notes-value"
                    data-url="@Url.Action("RevealNotes", "Vault", new { id = Model.Id })">
                <i class="bi bi-eye"></i> Reveal
            </button>

            <button type="button" id="btnCopyNotes" class="btn btn-outline-secondary" data-copy-target="#notes-value"
                    disabled>
                <i class="bi bi-clipboard"></i> Copy
            </button>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/clipboard.js" asp-append-version="true"></script>
    <script>
        (function () {
            'use strict';
            const AUTO_HIDE_MS = 30000;

            function getToken() {
                const el = document.querySelector('#af-token input[name="__RequestVerificationToken"]');
                return el ? el.value : '';
            }

            function setRevealed(el, revealed, plaintext) {
                el.setAttribute('data-revealed', revealed ? 'true' : 'false');
                if (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement) {
                    el.value = revealed ? plaintext : el.getAttribute('data-masked');
                } else {
                    el.textContent = revealed ? plaintext : el.getAttribute('data-masked');
                }
            }

            function updateButtonLabel(btn, revealed) {
                const icon = revealed ? 'bi-eye-slash' : 'bi-eye';
                const label = revealed ? 'Hide' : 'Reveal';
                btn.innerHTML = '<i class="bi ' + icon + '"></i> ' + label;
                btn.classList.toggle('btn-outline-primary', !revealed);
                btn.classList.toggle('btn-warning', revealed);
            }

            document.querySelectorAll('.js-reveal').forEach(btn => {
                btn.addEventListener('click', async () => {
                    const target = document.getElementById(btn.dataset.target);
                    if (!target) return;

                    // --- Hide (toggle back) ---
                    if (target.getAttribute('data-revealed') === 'true') {
                        setRevealed(target, false, null);
                        updateButtonLabel(btn, false);
                        if (btn._timer) clearTimeout(btn._timer);
                        return;
                    }

                    // --- Reveal ---
                    btn.disabled = true;
                    try {
                        const body = new URLSearchParams();
                        body.append('__RequestVerificationToken', getToken());

                        const res = await fetch(btn.dataset.url, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body
                        });

                        if (!res.ok) {
                            alert('Unable to reveal value.');
                            return;
                        }

                        const data = await res.json();
                        setRevealed(target, true, data.value);
                        updateButtonLabel(btn, true);

                        // Auto-hide after 30s
                        btn._timer = setTimeout(() => {
                            setRevealed(target, false, null);
                            updateButtonLabel(btn, false);
                        }, AUTO_HIDE_MS);
                    } catch {
                        alert('Network error while revealing value.');
                    } finally {
                        btn.disabled = false;
                    }
                });
            });
        })();
    </script>
}