@model CipherVault.ViewModels.VaultIndexViewModel
@using CipherVault.Helpers
@{
    ViewData["Title"] = "My Vault";

    // Pagination window — computed once, used below.
    const int windowSize = 2;
    int startPage = Math.Max(1, Model.Page - windowSize);
    int endPage = Math.Min(Model.TotalPages, Model.Page + windowSize);
    if (Model.TotalPages < 1) { startPage = 1; endPage = 1; }
}

<div class="page-header">
    <div>
        <h1><i class="bi bi-key-fill"></i> My Vault</h1>
        <span class="page-subtitle">
            @Model.TotalCount item@(Model.TotalCount == 1 ? "" : "s") in your encrypted vault
        </span>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> New Item
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i>
        <span>@TempData["Success"]</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@* ---------- Toolbar: search + filter ---------- *@
<form method="get" asp-action="Index" class="vault-toolbar">
    <div class="vault-search">
        <i class="bi bi-search"></i>
        <input type="text" name="search" value="@Model.Search" class="form-control"
               placeholder="Search title, username, or URL..." autocomplete="off" />
    </div>

    <select name="category" class="form-select vault-filter">
        <option value="">All Categories</option>
        @foreach (var cat in new[] { "Password", "Note", "API Key", "Credit Card", "Other" })
        {
            <option value="@cat" selected="@(cat == Model.Category)">@cat</option>
        }
    </select>

    <div class="vault-filter-actions">
        <button type="submit" class="btn btn-outline-light">
            <i class="bi bi-funnel"></i> Filter
        </button>
        @if (!string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.Category))
        {
            <a asp-action="Index" class="btn btn-ghost" title="Clear filters">
                <i class="bi bi-x-lg"></i>
            </a>
        }
    </div>

    <span class="vault-toolbar-count">
        @Model.TotalCount item@(Model.TotalCount == 1 ? "" : "s")
    </span>
</form>

@* ---------- Results ---------- *@
@if (Model.Items.Count == 0)
{
    <div class="vault-empty">
        <div class="vault-empty-icon">
            <i
            class="bi @(string.IsNullOrWhiteSpace(Model.Search) && string.IsNullOrWhiteSpace(Model.Category) ? "bi-shield-lock" : "bi-search")"></i>
        </div>

        @if (string.IsNullOrWhiteSpace(Model.Search) && string.IsNullOrWhiteSpace(Model.Category))
        {
            <h3>Your vault is empty</h3>
            <p>Start by adding your first encrypted item. Secrets are encrypted before they ever hit the database.</p>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> Create your first item
            </a>
        }
        else
        {
            <h3>No items match your filters</h3>
            <p>Try a different search term or clear the filters to see everything.</p>
            <a asp-action="Index" class="btn btn-outline-light">
                <i class="bi bi-x-lg"></i> Clear filters
            </a>
        }
    </div>
}
else
{
    <div class="vault-grid">
        @foreach (var item in Model.Items)
        {
            <article class="vault-card">

                @* ----- Header: icon + actions menu ----- *@
                <div class="vault-card-header">
                    <span class="vault-card-icon" data-category="@item.Category">
                        <i class="bi @VaultCategoryIcons.For(item.Category)"></i>
                    </span>

                    <div class="vault-card-menu">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn-icon" title="View details">
                            <i class="bi bi-eye-fill"></i>
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn-icon" title="Edit">
                            <i class="bi bi-pencil-fill"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn-icon btn-icon-danger" title="Delete">
                            <i class="bi bi-trash-fill"></i>
                        </a>
                    </div>
                </div>

                @* ----- Body: title + username + secret ----- *@
                <div class="vault-card-body">
                    <a asp-action="Details" asp-route-id="@item.Id" class="vault-card-title">
                        @item.Title
                    </a>

                    @if (!string.IsNullOrWhiteSpace(item.Username))
                    {
                        <span class="vault-card-username">
                            <i class="bi bi-person"></i>
                            <span>@item.Username</span>
                        </span>
                    }
                    else
                    {
                        <span class="vault-card-username is-empty">
                            <i class="bi bi-person"></i>
                            <span>No username</span>
                        </span>
                    }

                    <div class="vault-card-secret">
                        <i class="bi bi-shield-lock-fill"></i>
                        <span>@item.MaskedSecret</span>
                    </div>
                </div>

                @* ----- Footer: badge + timestamp ----- *@
                <footer class="vault-card-footer">
                    <span class="badge badge-category" data-category="@item.Category">
                        @item.Category
                    </span>
                    <span class="updated" title="Last updated">
                        <i class="bi bi-clock"></i>
                        @item.UpdatedAt.ToLocalTime().ToString("MMM dd, yyyy")
                    </span>
                </footer>

            </article>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Vault pagination">
            <ul class="pagination">

                <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-search="@Model.Search"
                       asp-route-category="@Model.Category" asp-route-page="@(Model.Page - 1)" aria-label="Previous">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>

                @if (startPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-route-search="@Model.Search"
                           asp-route-category="@Model.Category" asp-route-page="1">1</a>
                    </li>
                    if (startPage > 2)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    }
                }

                @for (int i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-search="@Model.Search"
                           asp-route-category="@Model.Category" asp-route-page="@i">@i</a>
                    </li>
                }

                @if (endPage < Model.TotalPages)
                {
                    if (endPage < Model.TotalPages - 1)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    }
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-route-search="@Model.Search"
                           asp-route-category="@Model.Category" asp-route-page="@Model.TotalPages">@Model.TotalPages</a>
                    </li>
                }

                <li class="page-item @(Model.HasNext ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-search="@Model.Search"
                       asp-route-category="@Model.Category" asp-route-page="@(Model.Page + 1)" aria-label="Next">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>

            </ul>
        </nav>

        <p class="vault-pagination-info">
            Showing <strong>@Model.FirstItemOnPage</strong>–<strong>@Model.LastItemOnPage</strong>
            of <strong>@Model.TotalCount</strong> items
        </p>
    }
}