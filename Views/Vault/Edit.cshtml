@model CipherVault.DTOs.VaultItemUpdateDTO
@{
    ViewData["Title"] = "Edit Vault Item";
    var hasNotes = ViewData["HasNotes"] as bool? ?? false;
}

<h1 class="h3 mb-3">Edit Vault Item</h1>

<div class="row">
    <div class="col-lg-7">
        <form asp-action="Edit" asp-route-id="@ViewData["ItemId"]" method="post" autocomplete="off">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Category" class="form-label"></label>
                <select asp-for="Category" class="form-select"
                        asp-items="@(new SelectList(CipherVault.Models.VaultCategory.All, Model.Category))"></select>
                <span asp-validation-for="Category" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Username" class="form-label"></label>
                <input asp-for="Username" class="form-control" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Secret" class="form-label"></label>
                <input asp-for="Secret" id="Secret" class="form-control"
                       placeholder="Leave blank to keep existing value" />
                <span asp-validation-for="Secret" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Url" class="form-label"></label>
                <input asp-for="Url" class="form-control" placeholder="https://example.com" />
                <span asp-validation-for="Url" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" rows="4" class="form-control"
                          placeholder="Leave blank to keep existing value"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>

                @if (hasNotes)
                {
                    <div class="form-check mt-2">
                        <input class="form-check-input" type="checkbox" name="clearNotes" value="true" id="clearNotes" />
                        <label class="form-check-label" for="clearNotes">
                            Clear existing notes
                        </label>
                    </div>
                }
            </div>

            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-action="Details" asp-route-id="@ViewData["ItemId"]" class="btn btn-link">Cancel</a>
        </form>
    </div>

    <div class="col-lg-5">
        <partial name="_PasswordGenerator" />
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/password-generator.js" asp-append-version="true"></script>
}