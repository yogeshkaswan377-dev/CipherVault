@{
    ViewData["Title"] = "Contact";
}

<div class="info-page">

    <div class="info-hero">
        <div class="info-hero-icon">
            <i class="bi bi-chat-dots-fill"></i>
        </div>
        <h1>Get in touch</h1>
        <p>
            Questions, feedback, or a security concern? Reach out through the channels below.
        </p>
    </div>

    @* ---------- Contact cards ---------- *@
    <div class="contact-grid">

        <a href="mailto:hello@ciphervault.local" class="contact-card">
            <span class="contact-card-icon"><i class="bi bi-envelope-fill"></i></span>
            <div class="contact-card-body">
                <div class="contact-card-label">Email</div>
                <div class="contact-card-value">hello@ciphervault.local</div>
                <div class="contact-card-hint">General questions &amp; feedback</div>
            </div>
        </a>

        <a href="mailto:security@ciphervault.local" class="contact-card">
            <span class="contact-card-icon" style="background: var(--danger-soft); color: var(--danger);">
                <i class="bi bi-shield-exclamation"></i>
            </span>
            <div class="contact-card-body">
                <div class="contact-card-label">Security</div>
                <div class="contact-card-value">security@ciphervault.local</div>
                <div class="contact-card-hint">Report vulnerabilities privately</div>
            </div>
        </a>

        <a href="https://github.com/yogeshkaswan377-dev/CipherVault" target="_blank" rel="noopener noreferrer"
           class="contact-card">
            <span class="contact-card-icon" style="background: rgba(255,255,255,0.05); color: var(--text-primary);">
                <i class="bi bi-github"></i>
            </span>
            <div class="contact-card-body">
                <div class="contact-card-label">Source Code</div>
                <div class="contact-card-value">github.com/ciphervault</div>
                <div class="contact-card-hint">View on GitHub</div>
            </div>
        </a>

    </div>

    @* ---------- Before you report a security issue ---------- *@
    <section class="info-section">
        <h2 class="info-section-title">
            <i class="bi bi-shield-exclamation"></i>
            <span>Reporting a vulnerability</span>
        </h2>

        <p>
            If you find a security issue, please <strong>do not open a public issue</strong>.
            Contact the security address above directly. Include:
        </p>

        <ul class="info-list">
            <li>A clear description of the issue</li>
            <li>Steps to reproduce it</li>
            <li>The potential impact you believe it has</li>
            <li>Any suggested mitigation (optional)</li>
        </ul>

        <p>
            You'll receive an acknowledgement within a reasonable timeframe.
            Coordinated disclosure is preferred.
        </p>
    </section>

    @* ---------- Response times ---------- *@
    <section class="info-section">
        <h2 class="info-section-title">
            <i class="bi bi-clock-history"></i>
            <span>Response times</span>
        </h2>

        <p>
            This is a learning project, not a commercial service. Responses may take a
            few days. Security reports are prioritised and reviewed first.
        </p>
    </section>

</div>