@{
    ViewData["Title"] = "Error";
}

<div class="error-page">

    <div class="error-icon">
        <i class="bi bi-exclamation-triangle-fill"></i>
    </div>

    <h1>Something went wrong</h1>

    <p>
        An unexpected error occurred while processing your request.
        Your data is safe — no changes were made.
    </p>

    <div class="home-hero-actions">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-house-door"></i> Go Home
        </a>
        <a asp-controller="Vault" asp-action="Index" class="btn btn-outline-light">
            <i class="bi bi-key"></i> My Vault
        </a>
    </div>

    @if (ViewData["RequestId"] != null)
    {
        <div class="error-details">
            <button type="button" id="error-details-toggle" class="error-details-toggle">
                <i class="bi bi-chevron-right" id="error-chevron"></i>
                <span>Technical details (for support)</span>
            </button>

            <div class="error-details-body" id="error-details-body">
                <div><strong>Request ID:</strong> @ViewData["RequestId"]</div>
            </div>
        </div>
    }

</div>

@section Scripts {
    <script>
        (function () {
            'use strict';
            const btn = document.getElementById('error-details-toggle');
            const body = document.getElementById('error-details-body');
            const chev = document.getElementById('error-chevron');
            if (!btn || !body) return;

            btn.addEventListener('click', () => {
                const open = body.classList.toggle('is-open');
                if (chev) {
                    chev.classList.toggle('bi-chevron-right', !open);
                    chev.classList.toggle('bi-chevron-down', open);
                }
            });
        })();
    </script>
}