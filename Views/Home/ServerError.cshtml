@{
    ViewData["Title"] = "Server Error";
}

<div class="text-center py-5">
    <div class="display-1 fw-bold text-danger" style="font-size: 6rem; line-height: 1;">500</div>
    <h2 class="mt-3">Something went wrong</h2>
    <p class="text-muted mt-2" style="max-width: 480px; margin: 0 auto;">
        An unexpected error occurred on our end. Your data is safe — please try again in a moment.
    </p>
    <div class="mt-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-house-door"></i> Go Home
        </a>
    </div>
</div>