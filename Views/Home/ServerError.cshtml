@{
    ViewData["Title"] = "Server Error";
}

<div class="home-hero">

    <div class="home-hero-icon" style="background: linear-gradient(135deg, var(--danger), #D08770);">
        <i class="bi bi-exclamation-triangle-fill"></i>
    </div>

    <h1 style="font-size: 3rem; margin-bottom: var(--space-2);">500</h1>
    <h2 style="color: var(--text-secondary); font-weight: 500; margin-bottom: var(--space-4);">
        Something went wrong
    </h2>

    <p class="lead">
        An unexpected error occurred on our end. Your data is safe —
        please try again in a moment.
    </p>

    <div class="home-hero-actions">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-house-door"></i> Go Home
        </a>
        <a asp-controller="Vault" asp-action="Index" class="btn btn-outline-light">
            <i class="bi bi-key"></i> My Vault
        </a>
    </div>

</div>