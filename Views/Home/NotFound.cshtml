@{
    ViewData["Title"] = "Page Not Found";
}

<div class="home-hero">

    <div class="home-hero-icon" style="background: linear-gradient(135deg, var(--warning), #D08770);">
        <i class="bi bi-compass"></i>
    </div>

    <h1 style="font-size: 3rem; margin-bottom: var(--space-2);">404</h1>
    <h2 style="color: var(--text-secondary); font-weight: 500; margin-bottom: var(--space-4);">
        Page not found
    </h2>

    <p class="lead">
        The page you're looking for doesn't exist, has been moved,
        or you don't have access to it.
    </p>

    <div class="home-hero-actions">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-house-door"></i> Go Home
        </a>
        <a asp-controller="Vault" asp-action="Index" class="btn btn-outline-light">
            <i class="bi bi-key"></i> My Vault
        </a>
    </div>

</div>