@{
    ViewData["Title"] = "Page Not Found";
}

<div class="text-center py-5">
    <div class="display-1 fw-bold text-muted" style="font-size: 6rem; line-height: 1;">404</div>
    <h2 class="mt-3">Page Not Found</h2>
    <p class="text-muted mt-2" style="max-width: 480px; margin: 0 auto;">
        The page you're looking for doesn't exist, has been moved, or you don't have access to it.
    </p>
    <div class="mt-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-house-door"></i> Go Home
        </a>
        <a asp-controller="Vault" asp-action="Index" class="btn btn-outline-light ms-2">
            <i class="bi bi-shield-lock"></i> My Vault
        </a>
    </div>
</div>