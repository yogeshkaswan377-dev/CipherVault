<div class="card" id="pwgen">
    <div class="card-header">Password Generator</div>
    <div class="card-body">

        <div class="input-group mb-2">
            <input type="text" id="pwgen-output" class="form-control font-monospace" readonly
                   placeholder="Click Generate" />
            <button type="button" class="btn btn-outline-secondary" id="pwgen-use">Use</button>
        </div>

        <div class="progress mb-1" style="height: 8px;">
            <div id="pwgen-strength-bar" class="progress-bar bg-secondary" role="progressbar" style="width: 0%;"></div>
        </div>
        <div class="small text-muted mb-3" id="pwgen-strength-label">—</div>

        <label for="pwgen-length" class="form-label">
            Length: <span id="pwgen-length-value">16</span>
        </label>
        <input type="range" class="form-range mb-2" id="pwgen-length" min="8" max="64" value="16" />

        <div class="d-flex flex-wrap gap-3 mb-3">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="pwgen-lower" checked />
                <label class="form-check-label" for="pwgen-lower">a-z</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="pwgen-upper" checked />
                <label class="form-check-label" for="pwgen-upper">A-Z</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="pwgen-digits" checked />
                <label class="form-check-label" for="pwgen-digits">0-9</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="pwgen-symbols" checked />
                <label class="form-check-label" for="pwgen-symbols">!@@#</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="pwgen-no-ambiguous" />
                <label class="form-check-label" for="pwgen-no-ambiguous">No ambiguous</label>
            </div>
        </div>

        <button type="button" class="btn btn-primary btn-sm" id="pwgen-generate">Generate</button>
        <div class="small text-muted mt-2">
            Uses <code>crypto.getRandomValues()</code> — cryptographically secure.
        </div>
    </div>
</div>