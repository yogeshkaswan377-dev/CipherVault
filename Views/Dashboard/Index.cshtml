@model CipherVault.DTOs.DashboardStatsDTO
@using CipherVault.Helpers
@{
    ViewData["Title"] = "Dashboard";

    // Helper to safely get a category count (list-based, not dictionary)
    int CountFor(string category) =>
        Model.CategoryCounts.FirstOrDefault(c => c.Category == category)?.Count ?? 0;
}

<div class="page-header">
    <div>
        <h1><i class="bi bi-speedometer2"></i> Dashboard</h1>
        <span class="page-subtitle">Overview of your encrypted vault</span>
    </div>
    <a asp-controller="Vault" asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> New Item
    </a>
</div>

@* ---------- KPI Cards ---------- *@
<div class="kpi-grid">

    <div class="kpi-card">
        <span class="kpi-icon"><i class="bi bi-collection"></i></span>
        <div class="kpi-body">
            <span class="kpi-label">Total Items</span>
            <span class="kpi-value">@Model.TotalItems</span>
            <span class="kpi-meta">in your vault</span>
        </div>
    </div>

    <div class="kpi-card">
        <span class="kpi-icon icon-success"><i class="bi bi-key-fill"></i></span>
        <div class="kpi-body">
            <span class="kpi-label">Passwords</span>
            <span class="kpi-value">@CountFor("Password")</span>
            <span class="kpi-meta">login credentials</span>
        </div>
    </div>

    <div class="kpi-card">
        <span class="kpi-icon icon-purple"><i class="bi bi-journal-text"></i></span>
        <div class="kpi-body">
            <span class="kpi-label">Secure Notes</span>
            <span class="kpi-value">@CountFor("Note")</span>
            <span class="kpi-meta">encrypted text</span>
        </div>
    </div>

    <div class="kpi-card">
        <span class="kpi-icon icon-warning"><i class="bi bi-shield-lock-fill"></i></span>
        <div class="kpi-body">
            <span class="kpi-label">API Keys</span>
            <span class="kpi-value">@CountFor("API Key")</span>
            <span class="kpi-meta">developer tokens</span>
        </div>
    </div>

</div>

@* ---------- Chart + Recent ---------- *@
<div class="dash-grid">

    <div class="card">
        <div class="card-header">
            <span>Items by Category</span>
        </div>
        <div class="card-body">
            <canvas id="categoryChart" height="90"></canvas>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <span>Recently Updated</span>
            <a asp-controller="Vault" asp-action="Index" class="text-accent small">
                View all <i class="bi bi-arrow-right"></i>
            </a>
        </div>
        <div class="card-body p-0">
            @if (Model.RecentItems.Count == 0)
            {
                <div class="text-center text-muted p-4 small">
                    No items yet.
                    <a asp-controller="Vault" asp-action="Create">Create one</a>.
                </div>
            }
            else
            {
                <ul class="recent-list">
                    @foreach (var item in Model.RecentItems)
                    {
                        <li>
                            <a asp-controller="Vault" asp-action="Details" asp-route-id="@item.Id" class="recent-item">
                                <span class="recent-icon">
                                    <i class="bi @VaultCategoryIcons.For(item.Category)"></i>
                                </span>
                                <span class="recent-info">
                                    <span class="recent-title">@item.Title</span>
                                    <span class="recent-meta">
                                        @item.Category &middot;
                                        <time class="js-local-time" datetime="@item.UpdatedAt.ToString("o")">
                                            @item.UpdatedAt.ToString("MMM dd")
                                        </time>
                                    </span>
                                </span>
                                <i class="bi bi-chevron-right recent-arrow"></i>
                            </a>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            const ctx = document.getElementById('categoryChart');
            if (!ctx) return;

            // Chart.js colors matched to Supabase theme
            const palette = {
                'Password': '#5E6AD2',   // Linear indigo (primary accent)
                'Note': '#A5AEFF',   // light indigo
                'API Key': '#F2C94C',   // amber
                'Credit Card': '#4CB782',   // Linear green
                'Other': '#62666D'    // muted grey
            };

            const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            Model.CategoryCounts.Select(c => c.Category)));
            const data = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            Model.CategoryCounts.Select(c => c.Count)));
            const colors = labels.map(l => palette[l] || '#6B6B6B');

            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: labels,
                    datasets: [{
                        data: data,
                        backgroundColor: colors,
                        borderColor: '#0F1011',
                        borderWidth: 3,
                        hoverBorderColor: '#F7F8F8',
                        hoverOffset: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '68%',
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                color: '#8A8F98',
                                font: { size: 12, family: 'inherit' },
                                padding: 14,
                                usePointStyle: true,
                                pointStyle: 'circle',
                                boxWidth: 8,
                                boxHeight: 8
                            }
                        },
                        tooltip: {
                            backgroundColor: '#141516',
                            borderColor: 'rgba(255,255,255,0.08)',
                            borderWidth: 1,
                            titleColor: '#F7F8F8',
                            bodyColor: '#8A8F98',
                            padding: 10,
                            displayColors: true,
                            boxPadding: 6,
                            cornerRadius: 6
                        }
                    }
                }
            });
        })();
    </script>
}